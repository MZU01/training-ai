# Copié en .env par setup.sh. Le fichier .env n'est jamais commité.
APP_ENV=local

# Webhook du salon Discord du club. C'est un secret.
# En local (APP_ENV=local), rien n'est envoyé : le message est écrit dans legacy/var/partages.log.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1234567890/remplacez-moi
